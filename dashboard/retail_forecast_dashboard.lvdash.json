{
  "datasets": [
    {
      "name": "ds_risk_summary",
      "displayName": "Risk Summary",
      "queryLines": [
        "SELECT\n",
        "  COUNT(CASE WHEN is_stockout_risk THEN 1 END) AS stockout_count,\n",
        "  COUNT(CASE WHEN is_overstock_risk THEN 1 END) AS overstock_count\n",
        "FROM retail_forecast.gold.forecast_demand\n",
        "WHERE week = (SELECT MAX(week) FROM retail_forecast.gold.forecast_demand)"
      ]
    },
    {
      "name": "ds_risk_detail",
      "displayName": "Risk Detail",
      "queryLines": [
        "SELECT\n",
        "  fd.store_id,\n",
        "  ds.store_name,\n",
        "  fd.sku,\n",
        "  dp.product_name,\n",
        "  dp.category,\n",
        "  ds.region,\n",
        "  fd.predicted_demand,\n",
        "  fd.avg_demand_last_12w,\n",
        "  CASE\n",
        "    WHEN fd.is_stockout_risk THEN 'Stockout'\n",
        "    WHEN fd.is_overstock_risk THEN 'Overstock'\n",
        "    ELSE 'OK'\n",
        "  END AS risk_type,\n",
        "  fd.week\n",
        "FROM retail_forecast.gold.forecast_demand fd\n",
        "JOIN retail_forecast.gold.dim_product dp ON fd.sku = dp.sku\n",
        "JOIN retail_forecast.gold.dim_store ds ON fd.store_id = ds.store_id\n",
        "WHERE (fd.is_stockout_risk OR fd.is_overstock_risk)\n",
        "  AND fd.week = (SELECT MAX(week) FROM retail_forecast.gold.forecast_demand)"
      ]
    },
    {
      "name": "ds_weekly_revenue",
      "displayName": "Weekly Revenue",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('WEEK', date_id) AS week_start,\n",
        "  ds.region,\n",
        "  SUM(ft.total_revenue) AS weekly_revenue\n",
        "FROM retail_forecast.gold.fact_transactions ft\n",
        "JOIN retail_forecast.gold.dim_store ds ON ft.store_id = ds.store_id\n",
        "GROUP BY week_start, ds.region\n",
        "ORDER BY week_start"
      ]
    },
    {
      "name": "ds_category_revenue",
      "displayName": "Revenue by Category",
      "queryLines": [
        "SELECT\n",
        "  dp.category,\n",
        "  SUM(ft.total_revenue) AS total_revenue\n",
        "FROM retail_forecast.gold.fact_transactions ft\n",
        "JOIN retail_forecast.gold.dim_product dp ON ft.sku = dp.sku\n",
        "GROUP BY dp.category\n",
        "ORDER BY total_revenue DESC"
      ]
    },
    {
      "name": "ds_promo_lift",
      "displayName": "Promotion Lift",
      "queryLines": [
        "SELECT dp.category, 'Promoted' AS promo_type, AVG(ft.quantity_sold) AS avg_qty\n",
        "FROM retail_forecast.gold.fact_transactions ft\n",
        "JOIN retail_forecast.gold.dim_product dp ON ft.sku = dp.sku\n",
        "WHERE ft.is_promoted = 1\n",
        "GROUP BY dp.category\n",
        "UNION ALL\n",
        "SELECT dp.category, 'Baseline' AS promo_type, AVG(ft.quantity_sold) AS avg_qty\n",
        "FROM retail_forecast.gold.fact_transactions ft\n",
        "JOIN retail_forecast.gold.dim_product dp ON ft.sku = dp.sku\n",
        "WHERE ft.is_promoted = 0\n",
        "GROUP BY dp.category"
      ]
    },
    {
      "name": "ds_active_promos",
      "displayName": "Active Promotions",
      "queryLines": [
        "SELECT\n",
        "  promo_id,\n",
        "  COALESCE(target_sku, target_category) AS sku_or_category,\n",
        "  COALESCE(target_store_id, target_region) AS store_id_or_region,\n",
        "  discount_pct,\n",
        "  channel,\n",
        "  promo_start_date,\n",
        "  promo_end_date\n",
        "FROM retail_forecast.gold.fact_promotions\n",
        "WHERE is_active = TRUE\n",
        "ORDER BY promo_start_date"
      ]
    },
    {
      "name": "ds_upcoming_promos",
      "displayName": "Upcoming Promotions",
      "queryLines": [
        "SELECT\n",
        "  promo_id,\n",
        "  COALESCE(target_sku, target_category) AS sku_or_category,\n",
        "  COALESCE(target_store_id, target_region) AS store_id_or_region,\n",
        "  discount_pct,\n",
        "  channel,\n",
        "  promo_start_date,\n",
        "  promo_end_date\n",
        "FROM retail_forecast.gold.fact_promotions\n",
        "WHERE is_future = TRUE\n",
        "ORDER BY promo_start_date\n",
        "LIMIT 50"
      ]
    }
  ],
